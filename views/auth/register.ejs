<%- include('../partials/header', { title: 'Registrarse - AgroMarca' }) %>

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="auth-header">
            <h2>Crear Cuenta</h2>
            <p>Regístrate en la plataforma AgroMarca para gestionar tus terrenos y logotipos.</p>
        </div>
        
        <form action="/auth/register" method="POST">
            <div class="form-group">
                <label for="email">Correo Electrónico:</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="nombre@correo.com" required>
            </div>
            
            <div class="form-group">
                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required minlength="6">
            </div>
            
            <button type="submit" class="btn btn-primary mt-4">Registrarse</button>
        </form>
        
        <p class="text-center mt-4" style="font-size: 0.9rem;">
            ¿Ya tienes una cuenta? <a href="/auth/login">Inicia sesión aquí</a>
        </p>
    </div>
</div>

<%- include('../partials/footer') %>