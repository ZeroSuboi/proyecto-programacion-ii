<%- include('../partials/header', { title: 'Iniciar Sesión - AgroMarca' }) %>

<div class="auth-wrapper">
    <div class="card auth-card">
        <div class="auth-header">
            <h2>Iniciar Sesión</h2>
            <p>Ingresa tus credenciales para acceder a tu panel de control.</p>
        </div>
        
        <form action="/auth/login" method="POST">
            <div class="form-group">
                <label for="email">Correo Electrónico:</label>
                <input type="email" id="email" name="email" class="form-control" placeholder="nombre@correo.com" required>
            </div>
            
            <div class="form-group">
                <label for="password">Contraseña:</label>
                <input type="password" id="password" name="password" class="form-control" placeholder="••••••••" required>
            </div>
            
            <button type="submit" class="btn btn-primary mt-4">Ingresar</button>
        </form>
        
        <p class="text-center mt-4" style="font-size: 0.9rem;">
            ¿No tienes cuenta? <a href="/">Regístrate aquí</a>
        </p>
    </div>
</div>

<%- include('../partials/footer') %>