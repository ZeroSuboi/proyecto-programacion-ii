<%- include('../partials/header', { title: 'Registrar Nueva Finca - AgroMarca' }) %>

<div style="max-width: 600px; margin: 2rem auto;">
    <div class="card">
        <h2 class="text-center" style="margin-bottom: 0.5rem;">🏡 Registrar Nueva Finca</h2>
        <p class="text-center" style="color: var(--text-muted); margin-bottom: 2rem;">Añade un nuevo terreno productor para el control de marcas y cosechas.</p>
        
        <form action="/fincas/nueva" method="POST">
            <div class="form-group">
                <label for="nombre">Nombre de la Finca:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" placeholder="Ej. Finca La Esperanza" required>
            </div>

            <div class="form-group">
                <label for="ubicacion">Ubicación / Dirección:</label>
                <input type="text" id="ubicacion" name="ubicacion" class="form-control" placeholder="Ej. Sector El Limón, Lote 4" required>
            </div>

            <div class="form-group">
                <label for="hectareas">Tamaño en Hectáreas:</label>
                <input type="number" id="hectareas" name="hectareas" class="form-control" step="0.01" min="0.01" placeholder="Ej. 12.50" required>
            </div>

            <button type="submit" class="btn btn-primary mt-4">Guardar Finca</button>
        </form>

        <div class="text-center mt-4">
            <a href="/dashboard" style="color: var(--text-muted); font-weight: 500;">← Volver al Panel de Control</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>