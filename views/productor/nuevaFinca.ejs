<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Registrar Nueva Finca</title>
</head>
<body>
    <h2>🏡 Registrar una Nueva Finca</h2>
    <p>Productor activo: <strong><%= user.email %></strong></p>
    
    <hr>

    <form action="/fincas/nueva" method="POST">
        
        <div>
            <label for="nombre">Nombre de la Finca:</label><br>
            <input 
                type="text" 
                id="nombre" 
                name="nombre" 
                placeholder="Ej. Finca La Esperanza" 
                required
            >
        </div>
        <br>

        <div>
            <label for="ubicacion">Ubicación / Dirección:</label><br>
            <input 
                type="text" 
                id="ubicacion" 
                name="ubicacion" 
                placeholder="Ej. Sector El Limón, Lote 4" 
                required
            >
        </div>
        <br>

        <div>
            <label for="hectareas">Tamaño en Hectáreas:</label><br>
            <input 
                type="number" 
                id="hectareas" 
                name="hectareas" 
                step="0.01" 
                min="0.01" 
                placeholder="Ej. 12.50" 
                required
            >
        </div>
        <br>

        <button type="submit">Guardar Finca</button>
    </form>

    <br>
    <hr>
    <a href="/dashboard">⬅️ Volver al Panel de Control</a>
</body>
</html>