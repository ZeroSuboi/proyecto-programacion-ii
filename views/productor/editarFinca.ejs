<%- include('../partials/header', { title: 'Editar Finca - AgroMarca' }) %>

<div style="max-width: 600px; margin: 2rem auto;">
    <div class="card">
        <h2 class="text-center" style="margin-bottom: 0.5rem;">✏️ Editar Finca</h2>
        <p class="text-center" style="color: var(--text-muted); margin-bottom: 2rem;">Modificando los datos de la propiedad asociada a <strong><%= user.email %></strong></p>
        
        <form action="/fincas/editar/<%= finca.id %>" method="POST">
            <div class="form-group">
                <label for="nombre">Nombre de la Finca:</label>
                <input type="text" id="nombre" name="nombre" class="form-control" value="<%= finca.nombre %>" required>
            </div>

            <div class="form-group">
                <label for="ubicacion">Ubicación / Dirección:</label>
                <input type="text" id="ubicacion" name="ubicacion" class="form-control" value="<%= finca.ubicacion %>" required>
            </div>

            <div class="form-group">
                <label for="hectareas">Tamaño en Hectáreas:</label>
                <input type="number" id="hectareas" name="hectareas" class="form-control" step="0.01" min="0.01" value="<%= finca.hectareas %>" required>
            </div>

            <button type="submit" class="btn btn-primary mt-4">Guardar Cambios</button>
        </form>

        <div class="text-center mt-4">
            <a href="/fincas" style="color: var(--text-muted); font-weight: 500;">← Cancelar y Volver al Listado</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>