<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cambiar Contraseña - Productor</title>
</head>
<body style="font-family: Arial, sans-serif; max-width: 500px; margin: 40px auto; padding: 0 20px; line-height: 1.6;">

    <h2>🔒 Cambiar Contraseña de Acceso</h2>
    <p>Escribe tu nueva clave de seguridad para actualizar tus credenciales.</p>
    <hr>

    <form id="formPassword" action="/perfil/password" method="POST" style="background-color: #f8f9fa; padding: 20px; border-radius: 6px; border: 1px solid #ddd;">
        
        <div style="margin-bottom: 15px;">
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Nueva Contraseña:</label>
            <input type="password" id="nuevaPassword" name="nuevaPassword" required minlength="6" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
        </div>

        <div style="margin-bottom: 15px;">
            <label style="display: block; font-weight: bold; margin-bottom: 5px;">Confirmar Nueva Contraseña:</label>
            <input type="password" id="confirmarPassword" name="confirmarPassword" required minlength="6" style="width: 100%; padding: 8px; border: 1px solid #ccc; border-radius: 4px; box-sizing: border-box;">
        </div>

        <p id="errorMatch" style="color: red; font-weight: bold; display: none; margin-bottom: 15px; margin-top: 0;"></p>

        <button type="submit" id="btnGuardar" style="background-color: #28a745; color: white; border: none; padding: 10px 15px; font-size: 1em; border-radius: 4px; cursor: pointer; font-weight: bold; width: 100%;">Actualizar Contraseña</button>
    </form>

    <br>
    <a href="/dashboard" style="color: #6c757d; text-decoration: none; font-weight: bold;">← Cancelar y Volver</a>

    <script>
        const nueva = document.getElementById('nuevaPassword');
        const confirma = document.getElementById('confirmarPassword');
        const errorMsg = document.getElementById('errorMatch');
        const btn = document.getElementById('btnGuardar');

        function validarCampos() {
            if (confirma.value && nueva.value !== confirma.value) {
                errorMsg.textContent = "❌ Las contraseñas no coinciden.";
                errorMsg.style.display = "block";
                btn.disabled = true;
                btn.style.backgroundColor = "#6c757d";
                btn.style.cursor = "not-allowed";
            } else {
                errorMsg.style.display = "none";
                btn.disabled = false;
                btn.style.backgroundColor = "#28a745";
                btn.style.cursor = "pointer";
            }
        }

        nueva.addEventListener('input', validarCampos);
        confirma.addEventListener('input', validarCampos);
    </script>
</body>
</html>