<%- include('../partials/header', { title: 'Cambiar Contraseña - AgroMarca' }) %>

<div style="max-width: 500px; margin: 2rem auto;">
    <div class="card">
        <h2 class="text-center" style="margin-bottom: 0.5rem;">🔒 Cambiar Contraseña</h2>
        <p class="text-center" style="color: var(--text-muted); margin-bottom: 2rem;">Ingresa tu nueva clave de seguridad para actualizar las credenciales de tu cuenta.</p>
        
        <form id="formPassword" action="/perfil/password" method="POST">
            <div class="form-group">
                <label for="nuevaPassword">Nueva Contraseña:</label>
                <input type="password" id="nuevaPassword" name="nuevaPassword" class="form-control" placeholder="Mínimo 6 caracteres" required minlength="6">
            </div>

            <div class="form-group">
                <label for="confirmarPassword">Confirmar Nueva Contraseña:</label>
                <input type="password" id="confirmarPassword" name="confirmarPassword" class="form-control" placeholder="Repite la contraseña" required minlength="6">
            </div>

            <div id="errorMatch" class="alert alert-warning" style="display: none; margin-bottom: 1.5rem; padding: 0.75rem;">
                ❌ Las contraseñas no coinciden.
            </div>

            <button type="submit" id="btnGuardar" class="btn btn-primary mt-2">Actualizar Contraseña</button>
        </form>

        <div class="text-center mt-4">
            <a href="/dashboard" style="color: var(--text-muted); font-weight: 500;">← Cancelar y Volver al Dashboard</a>
        </div>
    </div>
</div>

<script>
    const nueva = document.getElementById('nuevaPassword');
    const confirma = document.getElementById('confirmarPassword');
    const errorMsg = document.getElementById('errorMatch');
    const btn = document.getElementById('btnGuardar');

    function validarCampos() {
        if (confirma.value && nueva.value !== confirma.value) {
            errorMsg.style.display = "block";
            btn.disabled = true;
            btn.style.opacity = "0.6";
        } else {
            errorMsg.style.display = "none";
            btn.disabled = false;
            btn.style.opacity = "1";
        }
    }

    nueva.addEventListener('input', validarCampos);
    confirma.addEventListener('input', validarCampos);
</script>

<%- include('../partials/footer') %>
