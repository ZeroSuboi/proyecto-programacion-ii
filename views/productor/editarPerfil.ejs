<%- include('../partials/header', { title: 'Modificar Cuenta - AgroMarca' }) %>

<div style="max-width: 500px; margin: 2rem auto;">
    <div class="card">
        <h2 class="text-center" style="margin-bottom: 0.5rem;">📝 Actualizar Perfil</h2>
        <p class="text-center" style="color: var(--text-muted); margin-bottom: 2rem;">Modifica el correo electrónico asociado a tu acceso de productor.</p>
        
        <form action="/perfil/editar" method="POST">
            <div class="form-group">
                <label for="email">Correo electrónico de acceso:</label>
                <input type="email" id="email" name="email" class="form-control" value="<%= user.email %>" required placeholder="nombre@correo.com">
            </div>

            <button type="submit" class="btn btn-primary mt-4">Guardar Nuevo Correo</button>
        </form>

        <div class="text-center mt-4">
            <a href="/dashboard" style="color: var(--text-muted); font-weight: 500;">← Cancelar y Volver al Dashboard</a>
        </div>
    </div>
</div>

<%- include('../partials/footer') %>