<%- include('../partials/header', { title: 'Panel del Productor - AgroMarca' }) %>

<div class="mb-4">
    <h2>¡Bienvenido al Panel de Control, <%= user.email %>!</h2>
    <p style="color: var(--text-muted); font-size: 0.95rem;">
        Rol de acceso en el sistema: <span class="badge" style="background: rgba(255,255,255,0.05); color: #fff; border: 1px solid var(--border-color);"><%= user.rol %></span>
    </p>
</div>

<!-- Alerts / Notifications -->
<% if (alerta === 'exito') { %>
    <div class="alert alert-success">
        <strong>✨ ¡Análisis completado!</strong> Tu logotipo ha sido procesado de forma local y el inventario de marcas se ha actualizado con éxito.
    </div>
<% } %>

<% if (alerta === 'actualizado') { %>
    <div class="alert alert-success">
        <strong>⚙️ ¡Cuenta actualizada!</strong> El correo electrónico de acceso se ha modificado correctamente en la base de datos.
    </div>
<% } %>

<% if (alerta === 'password_cambiada') { %>
    <div class="alert alert-success">
        <strong>🔒 ¡Seguridad actualizada!</strong> Tu contraseña ha sido cambiada y encriptada de forma segura.
    </div>
<% } %>

<!-- Stats Grid -->
<div class="dashboard-grid">
    <div class="stat-card primary">
        <h4 style="color: var(--primary);">🏡 Terrenos en Control</h4>
        <div class="stat-value"><%= totalFincas %></div>
        <div class="stat-desc">Fincas nativas bajo tu propiedad</div>
    </div>

    <% 
        let statusClass = 'warning';
        let statusTitle = 'Sin Registrar';
        let statusDesc = 'Sube tu logotipo para proteger tu identidad de marca.';
        
        if (miLogo) {
            if (miLogo.estado_analisis === 'aprobado') {
                statusClass = 'success';
                statusTitle = 'Protegida (Original)';
                statusDesc = 'Análisis dHash completado. Sin plagio detectable.';
            } else if (miLogo.estado_analisis === 'plagio_detectado') {
                statusClass = 'danger';
                statusTitle = 'Riesgo de Copia';
                statusDesc = 'Se detectó alta similitud con una marca rival.';
            }
        }
    %>
    <div class="stat-card <%= statusClass %>">
        <h4 style="color: <%= statusClass === 'success' ? '#10b981' : (statusClass === 'danger' ? 'var(--danger)' : 'var(--warning)') %>;">
            🎨 Estatus de Identidad
        </h4>
        <div class="stat-value" style="font-size: 1.6rem; margin: 1rem 0;"><%= statusTitle %></div>
        <div class="stat-desc"><%= statusDesc %></div>
    </div>
</div>

<!-- Main Sections -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
    
    <!-- Fincas Management Card -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
            <h3 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                🏡 Gestión de Fincas
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
                Administra tus terrenos para el control de cosechas, añade nuevas propiedades o edita las existentes.
            </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="/fincas/nueva" class="btn btn-primary">+ Registrar Nueva Finca</a>
            <a href="/fincas" class="btn btn-secondary">Ver Mis Fincas</a>
        </div>
    </div>

    <!-- Security & Profile Card -->
    <div class="card" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
            <h3 style="display: flex; align-items: center; gap: 0.5rem; margin-bottom: 1rem;">
                ⚙️ Ajustes de Cuenta
            </h3>
            <p style="color: var(--text-muted); font-size: 0.95rem; margin-bottom: 1.5rem;">
                Configura tus accesos de seguridad, modifica tu correo electrónico o actualiza tu contraseña encriptada.
            </p>
        </div>
        <div style="display: flex; flex-direction: column; gap: 0.75rem;">
            <a href="/perfil/editar" class="btn btn-secondary">Modificar Correo</a>
            <a href="/perfil/password" class="btn btn-secondary">Cambiar Contraseña</a>
        </div>
    </div>

</div>

<!-- Brand Logo Identity Card -->
<div class="card" style="margin-top: 1.5rem;">
    <h3 style="margin-bottom: 1rem;">🎨 Identidad de Marca y Logotipo</h3>
    
    <% if (miLogo) { %>
        <div style="display: flex; flex-wrap: wrap; gap: 2rem; align-items: center; margin-bottom: 2rem; background: rgba(255,255,255,0.02); padding: 1.5rem; border-radius: var(--radius-md); border: 1px solid var(--border-color);">
            <div class="logo-preview-container" style="margin-bottom: 0;">
                <img src="<%= miLogo.ruta_imagen %>" alt="Logo de la marca" class="logo-image">
            </div>
            <div style="flex: 1; min-width: 250px;">
                <h4 style="margin-bottom: 0.75rem;">Detalles del Logotipo Registrado:</h4>
                <p style="margin-bottom: 0.5rem; font-size: 0.95rem;">
                    Huella Digital (dHash Hex): <code style="background: rgba(0,0,0,0.3); padding: 0.2rem 0.5rem; border-radius: 4px; color: var(--primary); font-family: monospace;"><%= miLogo.hash_perceptual %></code>
                </p>
                <p style="margin-bottom: 0.75rem; font-size: 0.95rem;">
                    Similitud con marcas rivales: 
                    <strong style="color: <%= Number(miLogo.porcentaje_similitud) > 10 ? 'var(--danger)' : 'var(--primary)' %>">
                        <%= miLogo.porcentaje_similitud ? Number(miLogo.porcentaje_similitud).toFixed(2) : '0.00' %>%
                    </strong>
                </p>
                <div>
                    Estado:
                    <% if (miLogo.estado_analisis === 'aprobado') { %>
                        <span class="badge badge-success">✅ Marca Protegida</span>
                    <% } else if (miLogo.estado_analisis === 'plagio_detectado') { %>
                        <span class="badge badge-danger">⚠️ Alta Similitud</span>
                    <% } else { %>
                        <span class="badge badge-warning">Sin Analizar</span>
                    <% } %>
                </div>
            </div>
        </div>
        <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.5rem; font-style: italic;">
            ¿Deseas actualizar tu logotipo? Sube una nueva imagen y el sistema reemplazará la anterior automáticamente.
        </p>
    <% } else { %>
        <div class="alert alert-warning" style="margin-bottom: 1.5rem;">
            ⚠️ Aún no has registrado ningún logotipo para proteger tu identidad de marca en la región.
        </div>
    <% } %>

    <form id="formLogo" action="/productor/analizar-logo" method="POST" enctype="multipart/form-data">
        <div class="form-group">
            <label style="font-weight: 600; display: block; margin-bottom: 8px;">Selecciona la imagen de tu logo (.png, .jpg, .jpeg):</label>
            <input type="file" id="inputLogo" name="logo" accept="image/*" required class="form-control" style="padding: 0.5rem;">
        </div>
        
        <div id="errorFrontend" class="alert alert-danger" style="display: none; padding: 0.75rem; margin-top: 10px;"></div>
        
        <button type="submit" id="btnSubir" class="btn btn-primary" style="max-width: 280px; display: block; margin-top: 1rem;">
            Subir y Analizar Similitud
        </button>
    </form>
</div>

<script>
    const inputLogo = document.getElementById('inputLogo');
    const errorFrontend = document.getElementById('errorFrontend');
    const btnSubir = document.getElementById('btnSubir');

    inputLogo.addEventListener('change', function() {
        const archivo = this.files[0];
        
        if (archivo) {
            const limiteMaximoBytes = 2 * 1024 * 1024; // 2MB
            
            if (archivo.size > limiteMaximoBytes) {
                errorFrontend.textContent = "❌ El archivo supera el límite de 2MB. Por favor, elige una imagen más ligera.";
                errorFrontend.style.display = "block";
                btnSubir.disabled = true;
                btnSubir.style.opacity = "0.6";
                btnSubir.style.cursor = "not-allowed";
            } else {
                errorFrontend.style.display = "none";
                btnSubir.disabled = false;
                btnSubir.style.opacity = "1";
                btnSubir.style.cursor = "pointer";
            }
        }
    });
</script>

<%- include('../partials/footer') %>